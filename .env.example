# ============================================
# AI出行管家 · 配置文件
# ============================================

# --- LLM 服务商配置 ---
LLM_PROVIDER=openai_compatible
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# --- Embedding 配置 ---
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- 行智 · Journey Hub (8001) ---
JOURNEY_HOST=0.0.0.0
JOURNEY_PORT=8001

# --- 策程 · Planner Core (8002) ---
PLANNER_HOST=0.0.0.0
PLANNER_PORT=8002
TRIP_DATA_DIR=./data/trips

# --- 感知 · Sense Engine (8003) ---
SENSE_HOST=0.0.0.0
SENSE_PORT=8003

# --- 外部数据源 (可选，留空则走 Mock 模式) ---
WEATHER_API_KEY=
WEATHER_BASE_URL=https://devapi.qweather.com
AMAP_API_KEY=
FLIGHT_API_KEY=
ATTRACTION_API_KEY=
ATTRACTION_BASE_URL=https://attractions.example.com

# --- 中间件 ---

# --- 鉴权 ---
DEV_API_KEY=ak_dev_local
# 会话签名密钥：登录 token 由 journey-hub 签发，planner-core 用同一密钥离线校验。
# 留空回退 DEV_API_KEY（本地开箱可用）；生产必须显式设置，否则可被伪造登录态。
SESSION_SECRET=

# --- 日志 ---
LOG_LEVEL=INFO
LOG_JSON=false
