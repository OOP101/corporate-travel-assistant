# ============================================
# 企业智行 · Corporate Journey Hub（v3）· 配置样例
# 用法：复制为 .env 后填写。留空的项走各自的默认值 / 降级路径。
# ============================================

# --- LLM 服务商（OpenAI 兼容协议）---
LLM_PROVIDER=openai_compatible
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# --- 多模型网关（腾讯 TokenHub 托管 混元 / DeepSeek / 智谱；key 空则该路由不注册）---
TENCENT_MAAS_API_KEY=
TENCENT_MAAS_BASE_URL=

# --- Embedding（可插拔四选一：auto / local / api / none）---
# auto   = 有本地模型用本地，否则试 api，都不可用则降级关键词检索
# local  = sentence-transformers 本地推理（BAAI/bge-large-zh-v1.5，1024 维）
# api    = 走 OpenAI 兼容 embeddings 接口
# none   = 直接关键词检索
EMBEDDING_PROVIDER=auto
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_API_MODEL=
EMBEDDING_DIM=0

# --- 服务内核（v3 单服务单端口）---
CORE_HOST=127.0.0.1
CORE_PORT=8001

# --- 数据存储（相对路径会被锚定到项目根）---
TRIP_DATA_DIR=./data/trips
PROFILE_DATA_DIR=./data/profiles
CHROMA_PERSIST_DIR=./data/chromadb

# --- 外部数据源（可选，key 留空则该能力关闭，不编造数据）---
# 地图：腾讯位置服务，SecretKey 用于自实现 SN 签名 sig=md5(路径?升序参数+SK)
TENCENT_MAP_KEY=
TENCENT_MAP_SK=
WEATHER_API_KEY=
WEATHER_BASE_URL=https://devapi.qweather.com
FLIGHT_API_KEY=
ATTRACTION_API_KEY=
ATTRACTION_BASE_URL=https://attractions.example.com

# --- 鉴权 ---
DEV_API_KEY=ak_dev_local
# 会话签名密钥（HMAC-SHA256 无状态 token）：
# 留空回退 DEV_API_KEY（本地开箱可用）；生产必须显式设置，否则任何知道默认 key
# 的人都能伪造登录态。注意：改了 SECRET 即所有已签发 token 立即失效。
SESSION_SECRET=

# --- 类型化决策层（shared/decision，默认关：单次约 2.7s）---
DECISION_SEMANTIC_AUTOFILL=0

# --- 日志 ---
LOG_LEVEL=INFO
LOG_JSON=false
