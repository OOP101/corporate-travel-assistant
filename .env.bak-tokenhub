# ============================================
# AI出行管家 · 配置文件
# ============================================

# --- LLM 服务商配置（API ①：对话/规划主模型） ---
# 服务商：腾讯 TokenHub（OpenAI 兼容，key 已设"全选"权限）
# Key 来源：TokenHub 控制台 → API Key 管理（已实测有效，勿外泄）
# 模型：hy-mt2-pro = 混元 Pro 旗舰（通用多任务，适合行程规划）
#       备选：deepseek-v4-flash（规划强）/ glm-5-turbo（智谱）
LLM_PROVIDER=openai_compatible
LLM_API_KEY=sk-D7I4yhUk4MmXrrZ6aTbXmN7MhezTPf4eH4hTvUKTzUBDXVh6
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_MODEL=hy-mt2-pro
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# --- Embedding 配置（向量化 / 政策文档 RAG 检索） ---
# 模式：auto | local | api | none
#   auto  → 本地模型可用则本地，否则接口，否则降级关键词检索
#   local → 本地 bge，数据不出企业（需 pip install sentence-transformers）
#   api   → OpenAI 兼容 /embeddings 接口
#   none  → 关闭向量，全部走关键词检索
EMBEDDING_PROVIDER=auto

# local 模式模型名（bge-small=512维 / bge-base=768维 / bge-large=1024维）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# api 模式（OpenAI 兼容接口）
# 注意：需在控制台为该 key 开通对应 embedding 模型权限，否则自动降级
EMBEDDING_BASE_URL=https://tokenhub.tencentmaas.com/v1
EMBEDDING_API_KEY=sk-D7I4yhUk4MmXrrZ6aTbXmN7MhezTPf4eH4hTvUKTzUBDXVh6
# api 模式专用模型名（留空则用 EMBEDDING_MODEL，但本地路径名不能用于 api）
EMBEDDING_API_MODEL=kinfra-text-embedding-0.6b

# 向量维度，0 = 自动推断
EMBEDDING_DIM=0

# --- 行智 · Journey Hub (8001) ---
JOURNEY_HOST=0.0.0.0
JOURNEY_PORT=8001

# --- 策程 · Planner Core (8002) ---
PLANNER_HOST=0.0.0.0
PLANNER_PORT=8002
TRIP_DATA_DIR=./data/trips

# --- 感知 · Sense Engine (8003) ---
SENSE_HOST=0.0.0.0
SENSE_PORT=8003

# --- 外部数据源 (可选，留空则走 Mock 模式) ---
WEATHER_API_KEY=
WEATHER_BASE_URL=https://devapi.qweather.com
AMAP_API_KEY=
FLIGHT_API_KEY=

# --- 中间件 ---
REDIS_URL=redis://redis:6379/0

# --- 鉴权 ---
DEV_API_KEY=ak_dev_local

# --- 日志 ---
LOG_LEVEL=INFO
LOG_JSON=false
